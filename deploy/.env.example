# Copy to .env and fill in real values:  cp .env.example .env
# .env is loaded automatically by `docker compose` from this directory.

# Image Watchtower pulls after each push to main (GH Actions builds this tag).
APP_IMAGE=ghcr.io/tenshinouta1979/myprofilesite:latest

# Cloudflare Tunnel token — Cloudflare Zero Trust dashboard >
# Networks > Tunnels > your tunnel > "Install connector" (token only).
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Secrets — generate each with:  openssl rand -hex 32
UMAMI_APP_SECRET=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# Optional: GitHub PAT (read-only) for the site's /api/github route
# to lift the unauthenticated API rate limit.
GITHUB_API_TOKEN=
